# Orchuulgin provider songoh: claude | deepl | google | demo
# demo = API key shaardahgui, tur zuuriin (testleheed)
TRANSLATE_PROVIDER=demo

# --- Claude (Anthropic) --- hamgiin sain chanar, albn barimtin ongo ays hadgalna
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- DeepL --- Japon/Angli orchuulgad mash sain
DEEPL_API_KEY=
# Free tier bol: https://api-free.deepl.com | Pro bol: https://api.deepl.com
DEEPL_API_URL=https://api-free.deepl.com

# --- Google Cloud Translation ---
GOOGLE_TRANSLATE_API_KEY=

PORT=3000
